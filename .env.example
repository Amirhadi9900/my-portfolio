# Gmail credentials for the contact form
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-app-password

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Public site key — safe to expose in the browser
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Secret key — server only, never commit real values
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Optional: lock verification to your production hostname
# TURNSTILE_EXPECTED_HOSTNAME=yourdomain.com

# --- Local development test keys (always pass) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
